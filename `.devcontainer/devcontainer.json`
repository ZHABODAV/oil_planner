{
  "name": "Edible Oils Planner",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8050],
  "portsAttributes": {
    "8050": {
      "label": "Planner UI",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "pip install -q -r requirements.txt && python app.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
